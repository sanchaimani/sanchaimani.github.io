<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            line-height: 1.6;
            color: #333;
            background-color: #f9f9f9;
            transition: background-color 0.3s, color 0.3s;
        }
        
        body.dark-mode {
            background-color: #222;
            color: #fff;
        }
        
        header {
            background: #35424a;
            color: white;
            padding: 20px 0;
            text-align: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        nav {
            display: flex;
            justify-content: space-between;
            padding: 0 10%;
            align-items: center;
        }
        
        nav ul {
            display: flex;
            list-style: none;
        }
        
        nav ul li {
            margin-left: 30px;
        }
        
        nav a {
            color: white;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
        }
        
        nav a:hover {
            color: #e8491d;
        }
        
        .hero {
            padding: 150px 0;
            text-align: center;
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
            background-size: cover;
            background-position: center;
            color: white;
        }
        
        .hero span {
            color: #e8491d;
        }
        
        .container {
            width: 80%;
            margin: auto;
            overflow: hidden;
        }
        
        section {
            padding: 80px 0;
            animation: fadeIn 1s ease-out;
        }
        
        h2 {
            text-align: center;
            margin-bottom: 40px;
            font-size: 2rem;
            color: #35424a;
        }
        
        body.dark-mode h2 {
            color: #fff;
        }
        
        .btn {
            display: inline-block;
            background: #e8491d;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 5px;
            margin-top: 20px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s;
            cursor: pointer;
        }
        
        .btn:hover {
            background: #cf401a;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        footer {
            background: #35424a;
            color: white;
            text-align: center;
            padding: 30px 0;
            margin-top: 50px;
        }
        
        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Skill bars */
        .skills-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }
        
        .skill {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        
        body.dark-mode .skill {
            background: #333;
        }
        
        .skill h3 {
            margin-bottom: 15px;
        }
        
        .skill-bar {
            height: 12px;
            background: #ddd;
            border-radius: 10px;
            margin: 10px 0;
            overflow: hidden;
        }
        
        body.dark-mode .skill-bar {
            background: #555;
        }
        
        .skill-level {
            height: 100%;
            background: #e8491d;
            border-radius: 10px;
            transition: width 1.5s ease-out;
        }
        
        /* Projects */
        .projects-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }
        
        .project {
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }
        
        body.dark-mode .project {
            background: #333;
        }
        
        .project:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        }
        
        .project h3 {
            color: #35424a;
            margin-bottom: 15px;
            font-size: 1.5rem;
        }
        
        body.dark-mode .project h3 {
            color: #fff;
        }
        
        .project p {
            margin-bottom: 15px;
        }
        
        .project .technologies {
            font-style: italic;
            color: #666;
            margin-bottom: 20px;
        }
        
        body.dark-mode .project .technologies {
            color: #ccc;
        }
        
        /* Contact Form */
        form {
            display: flex;
            flex-direction: column;
            max-width: 600px;
            margin: 0 auto;
            background: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        body.dark-mode form {
            background: #333;
        }
        
        input, textarea {
            padding: 12px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
            transition: border 0.3s;
        }
        
        body.dark-mode input,
        body.dark-mode textarea {
            background: #444;
            color: #fff;
            border-color: #555;
        }
        
        input:focus,
        textarea:focus {
            outline: none;
            border-color: #e8491d;
        }
        
        textarea {
            height: 150px;
            resize: vertical;
        }
        
        /* Dark mode toggle */
        #darkModeToggle {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #35424a;
            color: white;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            transition: all 0.3s;
        }
        
        #darkModeToggle:hover {
            transform: scale(1.1);
        }
        
        /* Responsive Design */
        @media (max-width: 900px) {
            .container {
                width: 90%;
            }
            
            nav {
                flex-direction: column;
                padding: 0;
            }
            
            nav ul {
                margin-top: 20px;
            }
            
            nav ul li {
                margin: 0 15px;
            }
        }
        
        @media (max-width: 768px) {
            .hero {
                padding: 100px 0;
            }
            
            .hero h1 {
                font-size: 2.2rem;
            }
            
            .hero h2 {
                font-size: 1.5rem;
            }
            
            section {
                padding: 60px 0;
            }
            
            .skills-container,
            .projects-container {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 480px) {
            nav ul {
                flex-direction: column;
                text-align: center;
            }
            
            nav ul li {
                margin: 10px 0;
            }
            
            .hero h1 {
                font-size: 1.8rem;
            }
            
            section {
                padding: 40px 0;
            }
            
            form {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <h1>My Portfolio</h1>
            <ul>
                <li><a href="#about">About</a></li>
                <li><a href="#skills">Skills</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <section class="hero">
        <div class="container">
            <h1>Hi, I'm <span>Sanchai</span></h1>
            <h2>A Passionate python and Web Developer </h2>
            <a href="#contact" class="btn">Get In Touch</a>
        </div>
    </section>

    <section id="about" class="container">
        <h2>About Me</h2>
        <div style="max-width: 800px; margin: 0 auto;">
            <p>I'm a recent Computer Science graduate with a passion for creating beautiful, functional websites and applications. I specialize in front-end development but enjoy working across the full stack.</p>
            <p>When I'm not coding, you can find me hiking, reading books, or experimenting with new recipes in the kitchen.</p>
            <a href="resume.pdf" download class="btn" style="display: inline-block; margin-top: 20px;">Download Resume</a>
        </div>
    </section>

    <section id="skills" class="container">
        <h2>My Skills</h2>
        <div class="skills-container">
            <!-- Skills will be populated by JavaScript -->
        </div>
    </section>

    <section id="projects" class="container">
        <h2>My Projects</h2>
        <div class="projects-container">
            <!-- Projects will be populated by JavaScript -->
        </div>
    </section>

    <section id="contact" class="container">
        <h2>Contact Me</h2>
        <form id="contactForm">
            <input type="text" placeholder="Your Name" required>
            <input type="email" placeholder="Your Email" required>
            <textarea placeholder="Your Message" required></textarea>
            <button type="submit" class="btn">Send Message</button>
        </form>
    </section>

    <footer>
        <p>&copy; <span id="year"></span> My Portfolio. All rights reserved.</p>
        <div style="margin-top: 20px;">
            <a href="https://github.com/sanchaimani" target="_blank" style="color: white; margin: 0 10px;">GitHub</a>
            <a href="https://linkedin.com/in/sanchai-mani-551933251" target="_blank" style="color: white; margin: 0 10px;">LinkedIn</a>
            <a href="https://hackerrank.com/sanchai612004" target="_blank" style="color: white; margin: 0 10px;">Hackerrank</a>
        </div>
    </footer>

    <button id="darkModeToggle">🌙</button>

    <script>
        // Current year for footer
        document.getElementById('year').textContent = new Date().getFullYear();

        // Skills data
        const skills = [
            { name: "HTML", level: 95 },
            { name: "CSS", level: 90 },
            { name: "JavaScript", level: 85 },
            { name: "Sql", level: 80 },
            { name: "Node.js", level: 75 },
            { name: "Python", level: 70 },
            { name: "Git", level: 85 },
            { name: "Responsive Design", level: 90 }
        ];

        // Projects data
        const projects = [
            {
                title: "Efficient and secure cnn training with split learning for mnist",
                description: "A fully responsive streamlit platform running with localhost that train and analyse.",
                technologies: ["PYTHON", "CNN"],
                link: "https://github.com/sanchaimani/Efficient-and-secure-cnn-with-split-learning.git"
            },
            {
                title: "Hospital Management System",
                description: "The application have access for doctors,staffs,patient to register and schedule appoinment.",
                technologies: ["HTML", "CSS", "JAVASCRIPT","Node.js"],
                link: "https://github.com/sanchaimani/Hospital-management.git"
            },
            {
                title: "Task Management ",
                description: "Productivity application for creating, organizing, and tracking tasks functionality.",
                technologies: ["HTML", "CSS", "JAVASCRIPT"],
                link: "https://github.com/sanchaimani/Todolist.git"
            }
        ];

        // Render skills
        const skillsContainer = document.querySelector('.skills-container');
        skills.forEach(skill => {
            const skillElement = document.createElement('div');
            skillElement.className = 'skill';
            skillElement.innerHTML = `
                <h3>${skill.name}</h3>
                <div class="skill-bar">
                    <div class="skill-level" style="width: ${skill.level}%"></div>
                </div>
                <p>${skill.level}%</p>
            `;
            skillsContainer.appendChild(skillElement);
        });

        // Render projects
        const projectsContainer = document.querySelector('.projects-container');
        projects.forEach(project => {
            const projectElement = document.createElement('div');
            projectElement.className = 'project';
            projectElement.innerHTML = `
                <h3>${project.title}</h3>
                <p>${project.description}</p>
                <p class="technologies"><strong>Technologies:</strong> ${project.technologies.join(', ')}</p>
                <a href="${project.link}" class="btn" target="_blank">View Project</a>
            `;
            projectsContainer.appendChild(projectElement);
        });

        // Smooth scrolling for navigation
        document.querySelectorAll('nav a').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });

        // Form submission
        const contactForm = document.getElementById('contactForm');
        contactForm.addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Thank you for your message! I will get back to you soon.');
            this.reset();
        });

        // Dark mode toggle
        const darkModeToggle = document.getElementById('darkModeToggle');
        darkModeToggle.addEventListener('click', () => {
            document.body.classList.toggle('dark-mode');
            darkModeToggle.textContent = document.body.classList.contains('dark-mode') ? '☀️' : '🌙';
            
            // Save preference to localStorage
            localStorage.setItem('darkMode', document.body.classList.contains('dark-mode'));
        });

        // Check for saved dark mode preference
        if (localStorage.getItem('darkMode') === 'true') {
            document.body.classList.add('dark-mode');
            darkModeToggle.textContent = '☀️';
        }

        // Animation for skill bars when they come into view
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const skillLevel = entry.target.querySelector('.skill-level');
                    skillLevel.style.width = skillLevel.style.width; // Triggers the transition
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.5 });

        document.querySelectorAll('.skill').forEach(skill => {
            observer.observe(skill);
        });
    </script>
</body>
</html>
